<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#8b1e2d">
  <title>The Daily Sports Page — Football</title>
  <meta name="description" content="Philadelphia-first NFL scores, schedules, standings, and stories.">
  <link rel="canonical" href="https://thedailysportspage.com/football/">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
  <meta property="og:site_name" content="The Daily Sports Page">
  <meta property="og:title" content="The Daily Sports Page — Football">
  <meta property="og:description" content="Philadelphia-first NFL scores, schedules, standings, and stories.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://thedailysportspage.com/football/">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="../static/icons/favicon.ico" sizes="any">
  <link rel="stylesheet" href="../static/css/daily-sports-page.css?v=20260827-football-weekly">
</head>
<body>
  <a href="#front-page" class="skip-link">Skip to content</a>
  <header class="masthead" role="banner">
    <div class="masthead-inner">
      <div class="masthead-kicker"><span>Independent Daily Coverage</span><strong>National Football League</strong><span>Daily Sports Page</span></div>
      <h1 class="masthead-title">The Daily Sports Page</h1>
      <div class="masthead-meta">
        <span class="masthead-date">{{ page.edition_date.strftime('%A, %B %-d, %Y') }}</span>
        <span class="masthead-sep">&bull;</span><span>{{ daypart_edition(page.generated_at) }}</span>
        <span class="masthead-sep">&bull;</span><span>Written at {{ format_eastern_time(page.generated_at) }}</span>
        <span class="masthead-sep">&bull;</span><span>Volume {{ volume_number(page.edition_date) }}</span>
      </div>
    </div>
  </header>
  {% set active_sport = "football" %}{% include "sections/sport-tabs.html.j2" %}
  <nav class="section-nav" aria-label="Football page sections">
    <ul>
      <li><a href="https://buymeacoffee.com/thedailysportspage" target="_blank" rel="noopener noreferrer">Buy me a beer 🍻</a></li>
      <li><a href="#scoreboard">Weekly Scoreboard &amp; Schedule</a></li>
      <li><a href="#standings">Standings</a></li><li><a href="#league-leaders">League Leaders</a></li><li><a href="#around-the-league">Around the NFL</a></li>
    </ul>
    <button class="print-btn" type="button" onclick="window.print()">Print</button>
  </nav>
  <main>
    <div class="top-news-grid football-top-news-grid">
      <section id="front-page" class="front-page section">
        {% if page.lead %}
        <article class="lead-story">
          <p class="section-label">Football Front Page</p><h2 class="lead-headline">{{ page.lead.headline }}</h2>
          <p class="story-deck">{{ page.lead.deck }}</p><p class="story-byline">By Daily Sports Page Staff</p>
          <div class="story-body">{% for paragraph in page.lead.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</div>
          <p class="source-link"><a href="{{ page.lead.url }}">Game recap on ESPN</a></p>
        </article>
        {% else %}<p class="no-content">The next NFL game story will appear after play is complete.</p>{% endif %}
      </section>
    </div>
    <section id="scoreboard" class="scoreboard section weekly-football-scoreboard"><h2 class="section-heading">{{ page.week_label }} Scoreboard &amp; Schedule{% if page.week_detail %} <small>{{ page.week_detail }}</small>{% endif %}</h2>
      {% if page.scoreboard %}<div class="standings-table-wrapper"><table class="scoreboard-table football-week-table" aria-label="{{ page.week_label }} NFL scores and schedule">
        <thead><tr><th>Date</th><th>Matchup</th><th>Score / Time</th><th>Status / TV</th></tr></thead><tbody>
        {% for game in page.scoreboard %}<tr{% if game.is_today %} class="is-today"{% endif %}><td>{% if game.is_today %}<strong>Today</strong><br>{% endif %}{{ game.date_label }}</td><td><strong>{{ game.away.abbr }} at {{ game.home.abbr }}</strong><br><small>{{ game.venue }}</small></td><td>{% if game.completed %}<strong>{{ game.away.score }}–{{ game.home.score }}</strong>{% else %}<strong>{{ game.time }}</strong>{% endif %}</td><td>{{ game.status }}{% if game.broadcast %}<br><small>{{ game.broadcast }}</small>{% endif %}</td></tr>{% endfor %}
        </tbody></table></div>{% else %}<p class="no-content">No NFL games are available for {{ page.week_label }}.</p>{% endif %}
    </section>
    <section id="standings" class="section standings"><h2 class="section-heading">NFL Standings</h2>
      {% if page.standings %}<div class="standings-grid">{% for division in page.standings %}<div class="standings-division"><h3>{{ division.name }}</h3>
        <table><thead><tr><th>Team</th><th>W</th><th>L</th><th>T</th><th>Pct</th><th>Diff</th></tr></thead><tbody>
        {% for row in division.rows %}<tr{% if row.abbr == 'PHI' %} class="is-primary-team"{% endif %}><td>{{ row.abbr }}</td><td>{{ row.wins }}</td><td>{{ row.losses }}</td><td>{{ row.ties }}</td><td>{{ row.pct }}</td><td>{{ row.diff }}</td></tr>{% endfor %}
      </tbody></table></div>{% endfor %}</div>{% else %}<p class="no-content">NFL standings are not available yet.</p>{% endif %}
    </section>
    <section id="league-leaders" class="section standings"><h2 class="section-heading">NFL League Leaders{% if page.leaders_season_label %} — {{ page.leaders_season_label }}{% endif %}</h2>
      {% if page.league_leaders %}<div class="standings-grid league-leaders-grid">{% for category in page.league_leaders %}<div class="standings-division league-leader-category"><h3>{{ category.label }}</h3>
        <table><thead><tr><th>Rank</th><th>Player</th><th>Team</th><th>{{ category.abbreviation or 'Stat' }}</th></tr></thead><tbody>
        {% for row in category.rows %}<tr{% if row.team == 'PHI' %} class="is-primary-team"{% endif %}><td>{{ row.rank }}</td><td>{% if row.url %}<a href="{{ row.url }}">{{ row.name }}</a>{% else %}{{ row.name }}{% endif %}{% if row.position %} <small>{{ row.position }}</small>{% endif %}</td><td>{{ row.team }}</td><td><strong>{{ row.value }}</strong></td></tr>{% endfor %}
        </tbody></table></div>{% endfor %}</div><p class="source-link"><a href="https://www.espn.com/nfl/stats">Full NFL statistics on ESPN</a></p>{% else %}<p class="no-content">NFL league leaders are not available yet.</p>{% endif %}
    </section>
    <section id="around-the-league" class="section around-the-league"><h2 class="section-heading">Around the NFL</h2>
      {% if page.news %}<div class="news-grid">{% for story in page.news %}<article class="news-item"><h3>{% if story.url %}<a href="{{ story.url }}">{{ story.headline }}</a>{% else %}{{ story.headline }}{% endif %}</h3><p>{{ story.description }}</p></article>{% endfor %}</div>{% else %}<p class="no-content">League stories are being gathered.</p>{% endif %}
    </section>
  </main>
  <footer class="site-footer"><p>The Daily Sports Page — Football Edition — {{ page.edition_date }}</p></footer>
  {% include "sections/web-analytics.html.j2" %}
</body>
</html>
