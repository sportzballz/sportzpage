{# templates/index.html.j2 #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#8b1e2d">
  <title>The Daily Sports Page &mdash; {{ edition.edition.date }}</title>
  <meta name="description" content="Philadelphia-first MLB scores, standings, league leaders, game recaps, and analysis.">
  <link rel="canonical" href="https://thedailysportspage.com/subscriber/current/">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
  <meta property="og:site_name" content="The Daily Sports Page">
  <meta property="og:title" content="The Daily Sports Page &mdash; {{ edition.edition.date }}">
  <meta property="og:description" content="Philadelphia-first MLB scores, standings, and analysis.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://thedailysportspage.com/subscriber/current/">
  <meta name="twitter:card" content="summary">
  <meta name="daily-sportz-page-edition-id" content="{{ edition.edition.id }}">
  <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
  <link rel="icon" href="{{ asset('icons/favicon.ico') }}" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('icons/favicon-32.png') }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('icons/apple-touch-icon.png') }}">
  <link rel="stylesheet" href="{{ asset('css/daily-sports-page.css') }}?v=20260827-responsive-tables">
</head>
<body>
  <a href="#front-page" class="skip-link">Skip to content</a>
  {% include "sections/masthead.html.j2" %}
  {% set active_sport = "baseball" %}
  {% include "sections/sport-tabs.html.j2" %}
  <nav class="section-nav" aria-label="Page sections">
    <ul>
      <li><a href="https://buymeacoffee.com/thedailysportspage" target="_blank" rel="noopener noreferrer">Buy me a beer 🍻</a></li>
      <li><a href="#scoreboard">Scoreboard</a></li>
      <li><a href="#todays-games">Today's Games</a></li>
      <li><a href="#standings">Standings</a></li>
      <li><a href="#box-scores">Box Scores</a></li>
      <li><a href="#league-leaders">League Leaders</a></li>
      <li><a href="#history">Baseball History</a></li>
      <li><a href="#team-leaders">Team Leaders</a></li>
      <li><a href="#around-the-league">Around the League</a></li>
      <li><a href="#transactions">Transactions</a></li>
    </ul>
    <button class="print-btn" type="button" onclick="window.print()">Print</button>
  </nav>
  <main>
    <div class="top-news-grid">
      {% include "sections/front-page.html.j2" %}
      <div class="top-news-rail">
        {% include "sections/scoreboard.html.j2" %}
      </div>
    </div>
    {% include "sections/todays-games.html.j2" %}
    {% include "sections/standings.html.j2" %}
    {% include "sections/box-scores.html.j2" %}
    {% include "sections/league-leaders.html.j2" %}
    {% include "sections/history.html.j2" %}
    {% include "sections/team-leaders.html.j2" %}
    {% include "sections/transactions.html.j2" %}
    {% include "sections/around-the-league.html.j2" %}
  </main>
  <footer class="site-footer">
    <p>The Daily Sports Page &mdash; {{ edition.edition.date }} &mdash;
    {% if edition.edition.generated_at %}
      Generated at {{ edition.edition.generated_at.strftime('%I:%M %p %Z') }}
    {% endif %}
    </p>
  </footer>
  <script src="{{ asset('js/daily-sports-page.js') }}"></script>
  {% include "sections/web-analytics.html.j2" %}
</body>
</html>
