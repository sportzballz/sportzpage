{# templates/sections/standings.html.j2 #}
<section id="standings" class="standings section" aria-labelledby="standings-heading">
  <h2 id="standings-heading" class="section-heading">Standings</h2>

  {% if edition.standings %}

  {% macro standings_table(rows, caption) %}
  <div class="standings-table-wrapper">
    <table class="standings-table">
      <caption>{{ caption }}</caption>
      <thead>
        <tr>
          <th scope="col" class="team-col">Team</th>
          <th scope="col" class="num-col">W</th>
          <th scope="col" class="num-col">L</th>
          <th scope="col" class="num-col">PCT</th>
          <th scope="col" class="num-col">GB</th>
          <th scope="col" class="num-col collapsible">L10</th>
          <th scope="col" class="num-col collapsible">Streak</th>
          <th scope="col" class="num-col collapsible">Home</th>
          <th scope="col" class="num-col collapsible">Away</th>
          <th scope="col" class="num-col collapsible">Diff</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr class="{% if row.team_abbr in edition.edition.market_teams %}is-primary-team {% endif %}{% if row.eliminated %}eliminated-row{% endif %}">
          <td class="team-col">
            {{ row.team_name }}
            {% if row.magic_number is not none %}
            <span class="magic-number" title="Magic number">M{{ row.magic_number }}</span>
            {% endif %}
            {% if row.eliminated %}
            <span class="eliminated-label" title="Eliminated">E</span>
            {% endif %}
          </td>
          <td class="num-col">{{ row.wins }}</td>
          <td class="num-col">{{ row.losses }}</td>
          <td class="num-col">{{ "%.3f"|format(row.pct) | replace('0.', '.') }}</td>
          <td class="num-col">{{ row.games_back if row.games_back != 0.0 else '&mdash;' }}</td>
          <td class="num-col collapsible">{{ row.last_10 }}</td>
          <td class="num-col collapsible">{{ row.streak }}</td>
          <td class="num-col collapsible">{{ row.home_record }}</td>
          <td class="num-col collapsible">{{ row.away_record }}</td>
          <td class="num-col collapsible {% if row.run_differential > 0 %}positive-diff{% elif row.run_differential < 0 %}negative-diff{% endif %}">
            {% if row.run_differential > 0 %}+{% endif %}{{ row.run_differential }}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endmacro %}

  {% macro playoff_table(rows, caption) %}
  <div class="standings-table-wrapper postseason-table-wrapper">
    <table class="standings-table postseason-table">
      <caption>{{ caption }}</caption>
      <thead>
        <tr>
          <th scope="col" class="num-col">Seed</th>
          <th scope="col" class="team-col">Team</th>
          <th scope="col" class="num-col">W</th>
          <th scope="col" class="num-col">L</th>
          <th scope="col" class="num-col">PCT</th>
          <th scope="col" class="status-col">Position</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr{% if row.team_abbr in edition.edition.market_teams %} class="is-primary-team"{% endif %}>
          <td class="num-col">{{ row.playoff_seed }}</td>
          <td class="team-col">{{ row.team_name }}</td>
          <td class="num-col">{{ row.wins }}</td>
          <td class="num-col">{{ row.losses }}</td>
          <td class="num-col">{{ "%.3f"|format(row.pct) | replace('0.', '.') }}</td>
          <td class="status-col">
            {% if row.division_leader %}Division leader{% else %}Wild Card {{ row.wild_card_rank }}{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endmacro %}

  {% macro wild_card_table(rows, caption) %}
  <div class="standings-table-wrapper postseason-table-wrapper">
    <table class="standings-table postseason-table wild-card-table">
      <caption>{{ caption }}</caption>
      <thead>
        <tr>
          <th scope="col" class="num-col">WC</th>
          <th scope="col" class="team-col">Team</th>
          <th scope="col" class="num-col">W</th>
          <th scope="col" class="num-col">L</th>
          <th scope="col" class="num-col">PCT</th>
          <th scope="col" class="num-col">GB</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr class="{% if row.team_abbr in edition.edition.market_teams %}is-primary-team {% endif %}{% if row.wild_card_rank and row.wild_card_rank <= 3 %}playoff-position{% elif row.wild_card_rank == 4 %}wild-card-cutline{% endif %}">
          <td class="num-col">{{ row.wild_card_rank }}</td>
          <td class="team-col">{{ row.team_name }}</td>
          <td class="num-col">{{ row.wins }}</td>
          <td class="num-col">{{ row.losses }}</td>
          <td class="num-col">{{ "%.3f"|format(row.pct) | replace('0.', '.') }}</td>
          <td class="num-col">{{ row.wild_card_gb if row.wild_card_gb not in (none, '0', '0.0') else '&mdash;' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endmacro %}

  {% for league_code, league_name in [('AL', 'American League'), ('NL', 'National League')] %}
  <section class="standings-league" aria-labelledby="standings-{{ league_code | lower }}">
    <h3 id="standings-{{ league_code | lower }}" class="standings-league-heading">{{ league_name }}</h3>
    <div class="standings-divisions">
      {% for division in edition.standings.divisions %}
        {% if division.division_name.startswith(league_code) %}
        {{ standings_table(division.rows, division.division_name) }}
        {% endif %}
      {% endfor %}
    </div>

    <div class="postseason-standings">
      {% for picture in edition.standings.playoff_pictures %}
        {% if picture.league == league_code %}
        {{ playoff_table(picture.rows, league_code ~ ' Playoff Picture') }}
        {% endif %}
      {% endfor %}
      {% for wc in edition.standings.wild_cards %}
        {% if wc.league == league_code %}
        {{ wild_card_table(wc.rows, league_code ~ ' Wildcard Hunt') }}
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  {% else %}
  <p class="no-content">Standings are not available for this edition.</p>
  {% endif %}
</section>
