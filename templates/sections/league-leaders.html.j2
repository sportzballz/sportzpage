{# templates/sections/league-leaders.html.j2 #}
<section id="league-leaders" class="league-leaders section" aria-labelledby="leaders-heading">
  <h2 id="leaders-heading" class="section-heading">League Leaders</h2>

  {% if edition.league_leaders %}

  {# Define display categories #}
  {% set batting_display = [
    ('hr', 'HR'),
    ('rbi', 'RBI'),
    ('avg', 'AVG'),
    ('ops', 'OPS'),
    ('obp', 'OBP'),
    ('slg', 'SLG'),
    ('r', 'R'),
    ('h', 'H'),
    ('sb', 'SB'),
  ] %}
  {% set pitching_display = [
    ('era', 'ERA'),
    ('wins', 'W'),
    ('k', 'SO'),
    ('saves', 'SV'),
    ('whip', 'WHIP'),
    ('holds', 'HLD'),
    ('ip', 'IP'),
  ] %}

  {% macro leaders_table(category_key, category_label, entries) %}
  {% if entries %}
  <div class="leaders-panel" id="leaders-panel-{{ category_key }}" role="tabpanel" aria-labelledby="leaders-tab-{{ category_key }}">
    <table class="leaders-table">
      <caption>{{ category_label }} Leaders</caption>
      <thead>
        <tr>
          <th scope="col" class="rank-col">RK</th>
          <th scope="col" class="player-col">Player</th>
          <th scope="col" class="team-col">Team</th>
          <th scope="col" class="value-col">{{ category_label }}</th>
        </tr>
      </thead>
      <tbody>
        {% for entry in entries %}
        <tr {% if not entry.qualified %}class="unqualified-row" title="Does not meet qualification threshold"{% endif %}>
          <td class="rank-col">{{ entry.rank }}</td>
          <td class="player-col">{{ entry.player_name }}<span class="player-pos">, {{ entry.position }}</span></td>
          <td class="team-col">{{ entry.team_abbr }}</td>
          <td class="value-col">{{ entry.value }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% endmacro %}

  <div class="leaders-tabs">
    <div class="leaders-tab-group">
      <h3 class="leaders-group-label">Batting</h3>
      <nav role="tablist" aria-label="Batting leaders categories" class="leaders-tablist" data-tablist-id="batting">
        {% for key, label in batting_display %}
        {% if key in edition.league_leaders.batting and edition.league_leaders.batting[key] %}
        <button
          role="tab"
          id="leaders-tab-{{ key }}"
          aria-controls="leaders-panel-{{ key }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}"
          class="leaders-tab {% if loop.first %}leaders-tab-active{% endif %}"
          data-category="{{ key }}"
          tabindex="{{ '0' if loop.first else '-1' }}"
        >{{ label }}</button>
        {% endif %}
        {% endfor %}
      </nav>
      <div class="leaders-panels" data-panels-group="batting">
        {% for key, label in batting_display %}
        {% if key in edition.league_leaders.batting and edition.league_leaders.batting[key] %}
        {{ leaders_table(key, label, edition.league_leaders.batting[key]) }}
        {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="leaders-tab-group">
      <h3 class="leaders-group-label">Pitching</h3>
      <nav role="tablist" aria-label="Pitching leaders categories" class="leaders-tablist" data-tablist-id="pitching">
        {% for key, label in pitching_display %}
        {% if key in edition.league_leaders.pitching and edition.league_leaders.pitching[key] %}
        <button
          role="tab"
          id="leaders-tab-{{ key }}"
          aria-controls="leaders-panel-{{ key }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}"
          class="leaders-tab {% if loop.first %}leaders-tab-active{% endif %}"
          data-category="{{ key }}"
          tabindex="{{ '0' if loop.first else '-1' }}"
        >{{ label }}</button>
        {% endif %}
        {% endfor %}
      </nav>
      <div class="leaders-panels" data-panels-group="pitching">
        {% for key, label in pitching_display %}
        {% if key in edition.league_leaders.pitching and edition.league_leaders.pitching[key] %}
        {{ leaders_table(key, label, edition.league_leaders.pitching[key]) }}
        {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% else %}
  <p class="no-content">League leaders are not available for this edition.</p>
  {% endif %}
</section>
