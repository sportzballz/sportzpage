{# templates/sections/team-leaders.html.j2 #}
<section id="team-leaders" class="team-leaders section" aria-labelledby="team-leaders-heading">
  <h2 id="team-leaders-heading" class="section-heading">Team Leaders</h2>
  <p class="section-subhead">Season leaders within each MLB club</p>

  {% if edition.team_season_leaders %}
  <div class="team-leaders-grid">
    {% for team in edition.team_season_leaders %}
    <div class="team-leaders-card">
      <h3 class="team-leaders-team">{{ team.team_name }} <span>{{ team.team_abbr }}</span></h3>
      <div class="team-leaders-groups">
        <table class="team-leaders-table">
          <caption>Batting</caption>
          <thead><tr><th scope="col">Stat</th><th scope="col">Player</th><th scope="col">Value</th></tr></thead>
          <tbody>
            {% for leader in team.batting %}
            <tr><th scope="row">{{ leader.label }}</th><td>{{ leader.player_name }}</td><td class="leader-value">{{ leader.value }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        <table class="team-leaders-table">
          <caption>Pitching</caption>
          <thead><tr><th scope="col">Stat</th><th scope="col">Player</th><th scope="col">Value</th></tr></thead>
          <tbody>
            {% for leader in team.pitching %}
            <tr><th scope="row">{{ leader.label }}</th><td>{{ leader.player_name }}</td><td class="leader-value">{{ leader.value }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="no-content">Team leaders are not available for this edition.</p>
  {% endif %}
</section>
