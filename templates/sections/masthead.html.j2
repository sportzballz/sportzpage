{# templates/sections/masthead.html.j2 #}
<header class="masthead" role="banner">
  <div class="masthead-inner">
    <div class="masthead-kicker">
      <span>Independent Daily Coverage</span>
      <strong>Major League Baseball</strong>
      <span>Daily Sports Page</span>
    </div>
    <h1 class="masthead-title">The Daily Sports Page</h1>
    <div class="masthead-meta">
      <span class="masthead-date">
        {{ format_edition_date(edition.edition.date) }}
      </span>
      <span class="masthead-sep">&bull;</span>
      <span class="masthead-edition-type">{{ daypart_edition(edition.edition.generated_at) }}</span>
      <span class="masthead-sep">&bull;</span>
      <span class="masthead-generated">
        Written at {{ format_eastern_time(edition.edition.generated_at) }}
      </span>
      <span class="masthead-sep">&bull;</span>
      <span class="masthead-freshness">
        Volume {{ volume_number(edition.edition.generated_at) }}
      </span>
    </div>
  </div>
</header>
